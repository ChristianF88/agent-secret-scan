root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml,md}]
indent_size = 2

[fixtures/**]
# Fixtures are generated byte-exact; never reformat them.
trim_trailing_whitespace = false
insert_final_newline = unset
